# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API keys).
#
# Both values are safe to ship inside the Android app: the publishable/anon key
# only works through Row Level Security, which this project's schema.sql sets up
# so a user can only ever read/write rows belonging to their own shop.
#
# NEVER put the service_role key here — it bypasses RLS entirely.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
